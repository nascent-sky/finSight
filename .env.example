# Backend only. Copy to .env; never prefix these with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# disabled (or unset): safe abstract intent requests and fixed synthetic demos
# can use the available Gemini quota. Personal financial context never goes
# to Gemini. No extra free-tier flag is needed.
# Use paid only after an operator verifies paid-service billing and the
# applicable data-handling terms for this exact API project/key; this permits
# explanations using relevant real financial context.
# The application cannot infer billing/privacy status from an API key.
GEMINI_DATA_HANDLING=disabled
# Optional full fictional-data development mode (all conditions required):
# GEMINI_DATA_HANDLING=development
# GEMINI_DEVELOPMENT_DATA=fictional
# GEMINI_DEVELOPMENT_UIDS=first-test-firebase-uid,second-test-firebase-uid
# Exact authenticated test UIDs only, never emails. These accounts must contain
# only fictional records. No client flag grants development access. Ordinary
# accounts retain protected processing. Do not use development for personal data.
# Disable by restoring disabled and clearing the two development settings.
GEMINI_DEVELOPMENT_DATA=
GEMINI_DEVELOPMENT_UIDS=
FIREBASE_PROJECT_ID=finsight-web
# Exact origin of the browser app. Local Netlify Dev:
AI_ALLOWED_ORIGIN=http://localhost:8891
# On Netlify use the production origin, e.g. https://your-site.netlify.app.
# If omitted on Netlify, URL and DEPLOY_PRIME_URL are used automatically.
