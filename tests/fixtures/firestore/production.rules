rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profile
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // User settings
      match /settings/{document} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // New transaction system
      match /transactions/{transactionId} {

        function isValidTransaction() {
          return request.resource.data.keys().hasOnly([
            "amount",
            "datetime",
            "type",
            "person",
            "paymentMethod",
            "category",
            "note"
          ])
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.datetime is string
          && request.resource.data.type in ["expense", "income"]
          && request.resource.data.person is string
          && request.resource.data.paymentMethod in ["cash", "upi"]
          && request.resource.data.category is string
          && request.resource.data.note is string;
        }

        allow read, delete: if request.auth != null
                            && request.auth.uid == userId;

        allow create, update: if request.auth != null
                              && request.auth.uid == userId
                              && isValidTransaction();
      }

      // Remembered income sources
      match /incomeSources/{sourceId} {

        function isValidIncomeSource() {
          return request.resource.data.keys().hasOnly(["person"])
                 && request.resource.data.person is string
                 && request.resource.data.person.size() > 0;
        }

        allow read: if request.auth != null
                    && request.auth.uid == userId;

        allow create, update: if request.auth != null
                              && request.auth.uid == userId
                              && isValidIncomeSource();

        allow delete: if request.auth != null
                      && request.auth.uid == userId;
      }
    }

    // Legacy expenses
    match /expenses/{expenseId} {

      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }
  }
}
